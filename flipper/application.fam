App(
    appid="sftv_tx",
    name="SFTV TX",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="sftv_app_main",
    requires=["gui", "storage", "notification"],
    stack_size=4 * 1024, # sstv_build_physical keeps ~1.5 kB of buffers on the stack
    fap_category="Tools",
    fap_icon="icon_10px.png",
    fap_icon_assets="images",
    fap_version="0.1",
    fap_description="Flipper TV: send a 400x240 picture to a Playdate over sound",
    fap_private_libs=[
        Lib(
            name="common",
            sources=["crc8.c", "rs.c", "sstv_codec.c", "sstv_frame.c", "sstv_preview.c", "pbm.c"],
        ),
    ],
)
